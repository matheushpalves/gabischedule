# Copie para .env (em produção: /etc/gabi/api.env) e preencha. Nunca faça commit do .env.

# Ambiente: development | production
NODE_ENV=production
# Porta/host do backend (o nginx faz o proxy de /api/* para cá).
# Na VPS é 3011 (a 3001 já é usada por outro serviço); em desenvolvimento use 3001 (proxy do Vite).
PORT=3011
HOST=127.0.0.1

# Conexão com o Postgres
DATABASE_URL=postgres://gabi:SENHA_FORTE@localhost:5432/gabi

# Base secreta do código de acesso (código = base + dia do mês em São Paulo).
# Fica SÓ aqui no servidor; nunca no frontend.
AUTH_BASE=0000

# Cookie de sessão com flag Secure. Deixe true em produção (HTTPS).
# Em desenvolvimento via http://localhost o Chrome aceita Secure; no Safari use false.
COOKIE_SECURE=true

# Proxies confiáveis para ler o IP real (X-Forwarded-For). O nginx roda na mesma máquina.
TRUST_PROXY=127.0.0.1,::1

# Web Push (gere com: npm run vapid -w api)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato exigido pelo protocolo Web Push (mailto: ou https:)
VAPID_SUBJECT=mailto:seu-email@exemplo.com
