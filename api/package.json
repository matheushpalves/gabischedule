{
  "name": "@gabi/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "vapid": "tsx src/gen-vapid.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "fastify": "^5.6.0",
    "luxon": "^3.7.0",
    "node-cron": "^4.2.0",
    "pg": "^8.16.0",
    "web-push": "^3.6.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@gabi/shared": "1.0.0",
    "@types/luxon": "^3.7.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.0",
    "@types/web-push": "^3.6.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
